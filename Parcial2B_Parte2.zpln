 (km/h): double (nullable = true)\n |-- Wind Bearing (degrees): double (nullable = true)\n |-- Visibility (km): double (nullable = true)\n |-- Loud Cover: double (nullable = true)\n |-- Pressure (millibars): double (nullable = true)\n |-- Daily Summary: string (nullable = true)\n |-- fecha_f: timestamp (nullable = true)\n\n"}]},"focus":false},{"user":"anonymous","progress":0,"config":{"colWidth":12,"fontSize":9,"results":{},"enabled":true,"editorSetting":{}},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=10"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=11"},{"jobUrl":"http://10.0.5.2:4040/jobs/job?id=12"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1752107372435_944530765","id":"paragraph_1752107372435_944530765","dateCreated":"2025-07-10T00:29:32+0000","status":"FINISHED","text":"import org.apache.spark.sql.types._\r\nimport org.apache.spark.sql.functions._\r\n\r\nval dateColsNames = dfWeatherClean\r\n    .schema\r\n    .fields\r\n    .filter {\r\n        case StructField(_, TimestampType | DateType, _, _) => true\r\n        case _ => false\r\n    }.map(_.name)\r\n\r\nval statsExprs = dateColsNames\r\n    .flatMap { colName =>\r\n        Seq(\r\n            count(col(colName)).alias(s\"${colName}_count\"),\r\n            min(col(colName)).alias(s\"${colName}_min\"),\r\n            max(col(colName)).alias(s\"${colName}_max\"),\r\n            countDistinct(col(colName)).alias(s\"${colName}_countDistinct\")\r\n        )\r\n\r\n    }\r\nval dfStatsDateCols = dfWeatherClean\r\n    .select(statsExprs: _*)\r\ndfStatsDateCols.show()","focus":false,"dateUpdated":"2025-07-10T00:30:19+0000","dateFinished":"2025-07-10T00:30:21+0000","dateStarted":"2025-07-10T00:30:19+0000","results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+--------------------+---------------